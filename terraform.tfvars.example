# Hetzner
hcloud_token = "your-hetzner-cloud-api-token" # Change me
ssh_key_path = "~/.ssh/id_ed25519_n8n_dev.pub" # Change me
home_ip      = "your.ip.address/32" # Change me

# Server
server_name = "your-server-name" # Change me
server_type = "cx33"
location    = "fsn1"
image       = "ubuntu-24.04"
username    = "yourname" # Change me

# GitHub
github_org  = "build-automate"
github_repo = "n8n-production-platform"
github_pat  = "github_pat_xxxxxxxxxxxxx" # Change me

# Domain & Core
domain = "yourdomain.com" # Change me

# Security & Deployment
enable_firewall = true
enable_backups  = false
wait_for_dns    = true  # Wait for DNS propagation before starting services (recommended)

# Services to enable - change enabled = true/false for each service
# Secrets list must match what's in production.env.example in the docker repo
services = {
  baserow = {
    enabled = false
    secrets = ["SECRET_KEY", "DATABASE_PASSWORD", "REDIS_PASSWORD"]
  }
  nocodb = {
    enabled = false
    secrets = ["NOCODB_PASSWORD"]
  }
  minio = {
    enabled = false
    secrets = ["MINIO_ROOT_PASSWORD"]
  }
  postiz = {
    enabled = false
    secrets = ["POSTIZ_DB_PASSWORD", "POSTIZ_JWT_SECRET"]
  }
  nca-toolkit = {
    enabled = false
    secrets = ["NCA_API_KEY", "NCA_S3_ACCESS_KEY", "NCA_S3_SECRET_KEY"]
  }
  kokoro-tts = {
    enabled = false
    secrets = []
  }
}